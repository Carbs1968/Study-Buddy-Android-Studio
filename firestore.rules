rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ✅ User profiles
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // ✅ Academic Settings
      allow update: if isOwner(userId)
        && (
          !('academicSettings' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.keys().hasAll(['academicSettings'])
        );

      // ✅ Academic Settings
      match /academicSettings/{settingsId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      // ✅ Academic hierarchy
      match /academicYears/{academicYearId} {
        allow get, list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid;

        match /semesters/{semesterId} {
          allow get, list: if isOwner(userId);
          allow create, update, delete: if isOwner(userId)
            && request.resource.data.userId == request.auth.uid;

          match /classes/{classId} {
            allow get, list: if isOwner(userId);
            allow create, update, delete: if isOwner(userId)
              && request.resource.data.userId == request.auth.uid;

            match /materials/{materialId} {
              allow get, list: if isOwner(userId);

              allow create: if isOwner(userId)
                && request.resource.data.userId == request.auth.uid;

              allow update: if isOwner(userId)
                && resource.data.userId == request.auth.uid
                && request.resource.data.userId == request.auth.uid;

              allow delete: if isOwner(userId)
                && resource.data.userId == request.auth.uid;
            }

            match /studyGuides/{guideId} {
              allow get, list: if isOwner(userId);
              allow create, update, delete: if false;
            }
          }
        }
      }

      // ✅ Sessions
      match /sessions/{sessionId} {
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid;
        allow get, list: if isOwner(userId);
        allow update, delete: if isOwner(userId)
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
      }

      // ✅ Recordings
      match /recordings/{docId} {
        allow create: if isOwner(userId) &&
          request.resource.data.uid == request.auth.uid;
        allow get, list: if isOwner(userId);
        allow update, delete: if isOwner(userId) &&
          resource.data.uid == request.auth.uid;
      }
    }

    // ✅ Provider-neutral email lookup for support/troubleshooting
    match /userEmailLookup/{emailKey} {
      allow get: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create, update: if isSignedIn()
        && request.auth.token.email is string
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.emailLower is string
        && request.resource.data.emailLower == request.auth.token.email.lower()
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && emailKey == request.auth.token.email.lower();

      allow list, delete: if false;
    }

    // ✅ Legacy Users (uppercase)
    match /Users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ✅ AI Jobs
    match /aiJobs/{docId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.type in ['transcript', 'summary', 'notes', 'quiz'] &&
        request.resource.data.recordingId is string;
      allow read, update, delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid;
    }

    // 🚫 Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
